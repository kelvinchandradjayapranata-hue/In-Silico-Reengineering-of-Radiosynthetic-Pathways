<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version1/core" xmlns:fbc="http://www.sbml.org/sbml/level3/version1/fbc/version2" sboTerm="SBO:0000624" level="3" version="1" fbc:required="false">
  <model metaid="meta_melanin_radiosynthesis_fba_v2" id="melanin_radiosynthesis_fba_v2" name="Melanin radiosynthesis reduced stoichiometric model v2" fbc:strict="true">
    <listOfUnitDefinitions>
      <unitDefinition id="mmol_per_gDW_per_hr">
        <listOfUnits>
          <unit kind="mole" exponent="1" scale="-3" multiplier="1"/>
          <unit kind="gram" exponent="-1" scale="0" multiplier="1"/>
          <unit kind="second" exponent="-1" scale="0" multiplier="3600"/>
        </listOfUnits>
      </unitDefinition>
    </listOfUnitDefinitions>
    <listOfCompartments>
      <compartment id="c" constant="true"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="M_glc_c" name="D-glucose" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_o2_c" name="Oxygen" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_tyr_c" name="L-tyrosine" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_nad_c" name="NAD+" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_adp_c" name="ADP" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_pi_c" name="Phosphate" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_accoa_c" name="Acetyl-CoA" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_nadh_c" name="NADH" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_atp_c" name="ATP" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_co2_c" name="CO2" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_h2o_c" name="H2O" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_nadp_c" name="NADP+" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_ppp_c" name="Pentose phosphate (lumped)" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_nadph_c" name="NADPH" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_malcoa_c" name="Malonyl-CoA" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_thn_c" name="1,3,6,8-tetrahydroxynaphthalene (THN)" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_scytalone_c" name="Scytalone" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_t3hn_c" name="1,3,8-trihydroxynaphthalene (1,3,8-THN)" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_vermelone_c" name="Vermelone" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_dhn_c" name="1,8-dihydroxynaphthalene (DHN)" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_melanin_dhn_c" name="DHN-melanin" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_dopa_c" name="L-DOPA" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_dopaquinone_c" name="Dopaquinone" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_melanin_dopa_c" name="DOPA-melanin" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_biomass_c" name="Biomass precursor pool (placeholder)" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_e_red_c" name="Radiation-derived electron" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_e_energy_c" name="Radiation-derived energy" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter sboTerm="SBO:0000626" id="cobra_default_lb" value="-1000" constant="true"/>
      <parameter sboTerm="SBO:0000626" id="cobra_default_ub" value="1000" constant="true"/>
      <parameter sboTerm="SBO:0000626" id="cobra_0_bound" value="0" constant="true"/>
      <parameter sboTerm="SBO:0000626" id="minus_inf" value="-INF" constant="true"/>
      <parameter sboTerm="SBO:0000626" id="plus_inf" value="INF" constant="true"/>
      <parameter sboTerm="SBO:0000625" id="R_EX_GLC_upper_bound" value="5" units="mmol_per_gDW_per_hr" constant="true"/>
      <parameter sboTerm="SBO:0000625" id="R_EX_O2_upper_bound" value="20" units="mmol_per_gDW_per_hr" constant="true"/>
      <parameter sboTerm="SBO:0000625" id="R_EX_TYR_upper_bound" value="1" units="mmol_per_gDW_per_hr" constant="true"/>
      <parameter sboTerm="SBO:0000625" id="R_ATPM_lower_bound" value="10" units="mmol_per_gDW_per_hr" constant="true"/>
      <parameter sboTerm="SBO:0000625" id="R_ATPM_upper_bound" value="10" units="mmol_per_gDW_per_hr" constant="true"/>
      <parameter sboTerm="SBO:0000625" id="R_BIOMASS_lower_bound" value="0.1" units="mmol_per_gDW_per_hr" constant="true"/>
      <parameter sboTerm="SBO:0000625" id="R_BIOMASS_upper_bound" value="0.1" units="mmol_per_gDW_per_hr" constant="true"/>
      <parameter sboTerm="SBO:0000625" id="R_RAD_ELECTRON_IN_upper_bound" value="10" units="mmol_per_gDW_per_hr" constant="true"/>
      <parameter sboTerm="SBO:0000625" id="R_RAD_ENERGY_IN_upper_bound" value="10" units="mmol_per_gDW_per_hr" constant="true"/>
    </listOfParameters>
    <listOfReactions>
      <reaction id="R_EX_GLC" name="Glucose uptake" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="R_EX_GLC_upper_bound">
        <listOfProducts>
          <speciesReference species="M_glc_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_EX_O2" name="Oxygen uptake" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="R_EX_O2_upper_bound">
        <listOfProducts>
          <speciesReference species="M_o2_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_EX_TYR" name="L-tyrosine uptake" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="R_EX_TYR_upper_bound">
        <listOfProducts>
          <speciesReference species="M_tyr_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_GLYCOLYSIS" name="Glycolysis (lumped): glucose -&gt; 2 acetyl-CoA + 2 NADH + 2 ATP" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_nad_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_adp_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_pi_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_glc_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_accoa_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_nadh_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_atp_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_co2_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_h2o_c" stoichiometry="2" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_PPP" name="Pentose phosphate pathway (lumped NADPH source)" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_nadp_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_glc_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_h2o_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_ppp_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_nadph_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_co2_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_PPP_EXPORT" name="Pentose phosphate overflow" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_ppp_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
      </reaction>
      <reaction id="R_ACCARBOXYLASE" name="Acetyl-CoA carboxylase: acetyl-CoA + ATP + CO2 -&gt; malonyl-CoA" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_accoa_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_atp_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_co2_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_malcoa_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_adp_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_pi_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_PKS_THN" name="Non-reducing PKS: acetyl-CoA + 4 malonyl-CoA -&gt; THN" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_accoa_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_malcoa_c" stoichiometry="4" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_thn_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_co2_c" stoichiometry="4" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_THN_REDUCTASE" name="THN reductase: THN + NADPH -&gt; scytalone" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_thn_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_nadph_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_scytalone_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_nadp_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_SCYTALONE_DEHYDRATASE" name="Scytalone dehydratase: scytalone -&gt; 1,3,8-THN" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_scytalone_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_t3hn_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_h2o_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_T3HN_REDUCTASE" name="1,3,8-THN reductase: 1,3,8-THN + NADPH -&gt; vermelone" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_t3hn_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_nadph_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_vermelone_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_nadp_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_VERMELONE_DEHYDRATASE" name="Vermelone dehydratase: vermelone -&gt; DHN" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_vermelone_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_dhn_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_h2o_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_LACCASE_DHN" name="Laccase oxidation/polymerization: DHN -&gt; DHN-melanin" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_dhn_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_o2_c" stoichiometry="0.5" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_melanin_dhn_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_h2o_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_MELANIN_DHN_EXPORT" name="DHN-melanin export" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_melanin_dhn_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
      </reaction>
      <reaction id="R_TYROSINASE_CRESOLASE" name="Tyrosinase cresolase: L-tyrosine + O2 -&gt; L-DOPA" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_tyr_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_o2_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_dopa_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_h2o_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_TYROSINASE_CATECHOLASE" name="Tyrosinase catecholase: L-DOPA + 0.5 O2 -&gt; dopaquinone" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_dopa_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_o2_c" stoichiometry="0.5" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_dopaquinone_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_h2o_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_DOPA_MELANIN_FORMATION" name="Dopaquinone polymerization -&gt; DOPA-melanin (lumped)" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_dopaquinone_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_melanin_dopa_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_MELANIN_DOPA_EXPORT" name="DOPA-melanin export" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_melanin_dopa_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
      </reaction>
      <reaction id="R_RESPIRATION" name="Oxidative phosphorylation (lumped, P/O = 1): 2 NADH + 0.5 O2 -&gt; 2 ATP" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_nadh_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_o2_c" stoichiometry="0.5" constant="true"/>
          <speciesReference species="M_adp_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_pi_c" stoichiometry="2" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_nad_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_atp_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_h2o_c" stoichiometry="2" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_TRANS_HYDROGENASE" name="NADH/NADPH transhydrogenase" reversible="true" fast="false" fbc:lowerFluxBound="cobra_default_lb" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_nadh_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_nadp_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_nad_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_nadph_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_ATPM" name="ATP maintenance requirement" reversible="false" fast="false" fbc:lowerFluxBound="R_ATPM_lower_bound" fbc:upperFluxBound="R_ATPM_upper_bound">
        <listOfReactants>
          <speciesReference species="M_atp_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_h2o_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_adp_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_pi_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_BIOMASS" name="Biomass precursor demand (placeholder)" reversible="false" fast="false" fbc:lowerFluxBound="R_BIOMASS_lower_bound" fbc:upperFluxBound="R_BIOMASS_upper_bound">
        <listOfReactants>
          <speciesReference species="M_accoa_c" stoichiometry="2" constant="true"/>
          <speciesReference species="M_ppp_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_atp_c" stoichiometry="5" constant="true"/>
          <speciesReference species="M_nadph_c" stoichiometry="2" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_biomass_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_adp_c" stoichiometry="5" constant="true"/>
          <speciesReference species="M_pi_c" stoichiometry="5" constant="true"/>
          <speciesReference species="M_nadp_c" stoichiometry="2" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_BIOMASS_EXPORT" name="Biomass sink" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_biomass_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
      </reaction>
      <reaction id="R_RAD_ELECTRON_IN" name="Radiation electron input" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="R_RAD_ELECTRON_IN_upper_bound">
        <listOfProducts>
          <speciesReference species="M_e_red_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_RAD_ENERGY_IN" name="Radiation energy input" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="R_RAD_ENERGY_IN_upper_bound">
        <listOfProducts>
          <speciesReference species="M_e_energy_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_RAD_NADH_SYN" name="Radiation-driven NADH synthesis: electron + NAD+ -&gt; NADH" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_e_red_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_nad_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_nadh_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_RAD_ATP_SYN" name="Radiation-driven ATP synthesis: energy + ADP + Pi -&gt; ATP" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_e_energy_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_adp_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_pi_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="M_atp_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_h2o_c" stoichiometry="1" constant="true"/>
        </listOfProducts>
      </reaction>
      <reaction id="R_CO2_EX" name="CO2 exchange" reversible="true" fast="false" fbc:lowerFluxBound="cobra_default_lb" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_co2_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
      </reaction>
      <reaction id="R_H2O_EX" name="H2O exchange" reversible="true" fast="false" fbc:lowerFluxBound="cobra_default_lb" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_h2o_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
      </reaction>
    </listOfReactions>
    <fbc:listOfObjectives fbc:activeObjective="obj">
      <fbc:objective fbc:id="obj" fbc:type="maximize">
        <fbc:listOfFluxObjectives>
          <fbc:fluxObjective fbc:reaction="R_MELANIN_DHN_EXPORT" fbc:coefficient="1"/>
          <fbc:fluxObjective fbc:reaction="R_MELANIN_DOPA_EXPORT" fbc:coefficient="1"/>
        </fbc:listOfFluxObjectives>
      </fbc:objective>
    </fbc:listOfObjectives>
  </model>
</sbml>
